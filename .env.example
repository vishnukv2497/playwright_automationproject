# Copy to .env (gitignored) and fill in real values. Never commit .env.
BASE_URL=https://bankops.demo.transacthub.te.nestdigital.com

# Maker / primary automation user.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional — a checker distinct from the maker, for the Maker-Checker cases
# (TC-013, TC-014, TC-015, TC-043). Those tests are test.fixme() until these exist.
CHECKER_USERNAME=
CHECKER_PASSWORD=

# Optional — a user WITHOUT Charge Configuration access, for the access-denial
# case (TC-045). That test is test.fixme() until these exist.
READONLY_USERNAME=
READONLY_PASSWORD=

# Roles suite (tests/ui/roles) — runs against the dev host. ROLES_USERNAME/ROLES_PASSWORD are
# optional and fall back to ADMIN_USERNAME/ADMIN_PASSWORD.
ROLES_BASE_URL=https://bankops-dev.transacthub.te.nestdigital.com
ROLES_USERNAME=
ROLES_PASSWORD=

# Role Configuration suite (tests/ui/roleconfig, project "roleconfig") — also runs against ROLES_BASE_URL.
# An Admin Maker and a different Admin Checker (Maker-Checker flows). In CI, set these as secret variables.
MAKER_USER=
MAKER_PASS=
CHECKER_USER=
CHECKER_PASS=
